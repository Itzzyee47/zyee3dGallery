# Cloudinary Configuration
# Get these from https://cloudinary.com/console/settings/api-keys

# Your Cloudinary Cloud Name (found on dashboard)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Your Cloudinary Upload Preset (create in Settings > Upload > Upload Presets)
# Make sure to set "Unsigned" to ON
VITE_CLOUDINARY_UPLOAD_PRESET=gallery_unsigned

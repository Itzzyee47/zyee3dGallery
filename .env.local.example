# Cloudinary Configuration
# Get these from https://cloudinary.com/console/settings/api-keys

# Your Cloudinary Cloud Name (found on dashboard)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here

# Your Cloudinary Upload Preset (create in Settings > Upload > Upload Presets)
# Make sure to set "Unsigned" to ON
VITE_CLOUDINARY_UPLOAD_PRESET=gallery_unsigned

# Firebase Configuration
# Get these from Firebase Console > Project Settings > General
# 1. Go to https://console.firebase.google.com
# 2. Create a new project or select existing
# 3. Click Project Settings (gear icon)
# 4. Copy the Web App config values below

# Your Firebase API Key
VITE_FIREBASE_API_KEY=your_api_key_here

# Your Firebase Auth Domain (format: projectname.firebaseapp.com)
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com

# Your Firebase Project ID
VITE_FIREBASE_PROJECT_ID=your_project_id_here

# Optional: Firebase App ID
VITE_FIREBASE_APP_ID=your_app_id_here

